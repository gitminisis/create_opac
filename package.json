{
  "name": "create_opac",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install && npm add -g docsify",
    "start": "npm run gen && craco start ",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --plugin-search-dir=. --write .",
    "gen:schema": "node ./tools/gen-schema.mjs",
    "gen:theme": "node ./tools/gen-theme.mjs",
    "gen:types": "node ./tools/gen-types.mjs",
    "gen": "npm run gen:schema && npm run gen:theme && npm run gen:types",
    "doc": "docsify serve docs",
    "server": "tsx watch ./server/src/index.ts"
  },
  "dependencies": {
    "@fastify/env": "^4.3.0",
    "@icons-pack/react-simple-icons": "^9.3.0",
    "@radix-ui/react-accordion": "^1.1.2",
